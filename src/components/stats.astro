---
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";

const stats = [
  {
    value: business.stats.jobsCompleted,
    suffix: "+",
    label: "Jobs Completed",
    icon: "lucide:clipboard-check",
  },
  {
    value: business.stats.yearsInBusiness,
    suffix: "+",
    label: "Years in Business",
    icon: "lucide:calendar-days",
  },
  {
    value: business.stats.satisfactionRate,
    suffix: "%",
    label: "Customer Satisfaction",
    icon: "lucide:heart",
  },
  {
    value: business.stats.citiesServed,
    suffix: "+",
    label: "Cities Served",
    icon: "lucide:map-pin",
  },
];
---

<section class="relative isolate overflow-hidden bg-primary-900 text-white py-16 lg:py-20">
  <div class="hero-glow absolute inset-0 -z-10 opacity-60"></div>
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-y-10 lg:divide-x lg:divide-white/15">
      {stats.map((stat, i) => (
        <div class="group flex flex-col px-2 lg:px-10 lg:first:pl-0" data-aos="fade-up" data-aos-delay={(i + 1) * 80}>
          <dt class="text-white/70 text-sm font-medium mt-3 flex items-center gap-2"><Icon name={stat.icon} class="w-4 h-4 text-accent-400" />{stat.label}</dt>
                  <dd class="order-first font-heading font-extrabold text-5xl lg:text-6xl text-white leading-none">
            <span data-counter={stat.value} data-suffix={stat.suffix}>0{stat.suffix}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
