---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

// Row layouts that always fill 3 columns (so the grid never has a hole in it).
const SPANS: Record<number, number[]> = { 1: [3], 2: [2, 1], 3: [2, 1, 3], 4: [2, 1, 1, 2], 5: [2, 1, 1, 1, 1], 6: [2, 1, 1, 1, 1, 3] };
const spans = SPANS[services.length] ?? services.map(() => 1);
---

<section class="py-20 lg:py-28 bg-white" id="services">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="max-w-2xl" data-aos="fade-up">
      <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-primary-900 leading-[1.05]">
        Everything your property needs, from one crew
      </h2>
      <p class="text-neutral-600 text-lg mt-4 leading-relaxed max-w-xl">
        {business.niche} for homeowners and businesses in {business.city}. Every job comes with our {business.guaranteeText.toLowerCase()}.
      </p>
    </div>

    <!-- Bento: card widths per row add up to 3 columns on desktop, for any number of services. -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-12">
      {services.map((service, i) => {
        const wide = spans[i] >= 2;
        const dark = i === 0 && services.length > 1;
        const tint = wide && !dark;
        const icon = service.data.icon || "lucide:wrench";
        return (
          <a
            href={`/services/${service.data.urlSlug}`}
            class:list={[
              "group card-lift relative flex flex-col overflow-hidden rounded-2xl p-7 lg:p-8 min-h-[15rem]",
              wide && "sm:col-span-2",
              spans[i] === 2 && "lg:col-span-2",
              spans[i] === 3 && "lg:col-span-3",
              dark ? "bg-primary-900 text-white" : tint ? "bg-primary-50 ring-1 ring-primary-100" : "bg-white ring-1 ring-neutral-200 hover:ring-primary-200",
            ]}
            data-aos="fade-up"
            data-aos-delay={Math.min(i + 1, 4) * 80}
          >
            {dark && <div class="hero-glow pointer-events-none absolute inset-0 opacity-70"></div>}
            <div class:list={["relative grid h-12 w-12 place-items-center rounded-xl", dark ? "bg-white/10 text-accent-400" : "bg-primary-900 text-white"]}>
              <Icon name={icon} class="w-6 h-6" />
            </div>
            <h3 class:list={["relative font-heading font-bold mt-6", wide ? "text-3xl" : "text-xl", dark ? "text-white" : "text-primary-900"]}>
              {service.data.title}
            </h3>
            <p class:list={["relative mt-2 leading-relaxed flex-1", wide ? "text-base max-w-md" : "text-sm", dark ? "text-white/75" : "text-neutral-600"]}>
              {service.data.shortDesc}
            </p>
            <span class:list={["relative inline-flex items-center gap-1.5 mt-6 text-sm font-semibold transition-all group-hover:gap-2.5", dark ? "text-accent-400" : "text-primary-700"]}>
              See details
              <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </span>
          </a>
        );
      })}
    </div>

    <div class="mt-8" data-aos="fade-up">
      <a href="/services" class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-primary-900 transition-colors">
        View all services
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>
