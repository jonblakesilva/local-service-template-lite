---
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";

const projects = [
  {
    label: business.primaryServices[0],
    delay: 0,
    // Add real WebP photos from public/images/. Both before and after: a split card. Only after: a photo card.
    // No photos at all: this section is left out of the page.
    // e.g. after: "/images/service-one-after.webp"
    before: "",
    beforeAlt: `${business.primaryServices[0]} job before, ${business.name}`,
    after: "",
    afterAlt: `${business.primaryServices[0]} job after, ${business.name}`,
  },
  {
    label: business.primaryServices[1],
    delay: 100,
    before: "",
    beforeAlt: `${business.primaryServices[1]} job before, ${business.name}`,
    after: "",
    afterAlt: `${business.primaryServices[1]} job after, ${business.name}`,
  },
  {
    label: business.primaryServices[2],
    delay: 200,
    before: "",
    beforeAlt: `${business.primaryServices[2]} job before, ${business.name}`,
    after: "",
    afterAlt: `${business.primaryServices[2]} job after, ${business.name}`,
  },
];

const shown = projects.filter((p) => p.after);
const photos = shown.length >= 1;
---
{photos && (
<section class="py-20 lg:py-28 bg-neutral-50">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="max-w-2xl" data-aos="fade-up">
      <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-primary-900 leading-[1.05]">
        Recent work around {business.city}
      </h2>
      <p class="text-neutral-600 text-lg mt-4 leading-relaxed">
        Real projects, finished and cleaned up. Every one comes with our {business.guaranteeText.toLowerCase()}.
      </p>
    </div>

    <!-- Mosaic: one large photo and two stacked beside it. -->
    <div class="grid lg:grid-cols-3 lg:grid-rows-2 gap-5 mt-12">
      {shown.map((project, i) => (
        <figure
          data-aos="fade-up"
          data-aos-delay={project.delay}
          class:list={["group relative overflow-hidden rounded-2xl bg-primary-900 min-h-[16rem] sm:min-h-[20rem]", shown.length === 3 && i === 0 && "lg:col-span-2 lg:row-span-2 lg:min-h-[34rem]"]}
        >
          {project.before ? (
            <div class="absolute inset-0 grid grid-cols-2">
              <img src={project.before} alt={project.beforeAlt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
              <img src={project.after} alt={project.afterAlt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
            </div>
          ) : (
            <img src={project.after} alt={project.afterAlt} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
          )}
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent p-5 pt-16">
            <p class="text-white font-semibold leading-tight">{project.label}</p>
            <p class="text-white/70 text-sm mt-1">{business.city}, {business.state}</p>
          </div>
        </figure>
      ))}
    </div>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4" data-aos="fade-up">
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-7 h-14 rounded-xl transition-colors shadow-sm"
      >
        Get a free quote for your property
        <Icon name="lucide:arrow-right" class="w-5 h-5" />
      </a>
      <a href="/gallery" class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-primary-900 transition-colors">See the full gallery</a>
    </div>
  </div>
</section>
)}
