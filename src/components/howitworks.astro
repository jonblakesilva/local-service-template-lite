---
import { Icon } from "astro-icon/components";
const steps = [
  {
    number: "01",
    title: "Request a Free Quote",
    description:
      "Call us or fill out our quick online form. We'll ask a few questions to understand your needs and get back to you fast, usually the same business day.",
    icon: "lucide:message-square-text",
  },
  {
    number: "02",
    title: "We Show Up On Time",
    description:
      "Our team arrives at the scheduled window, introduces themselves, and does a quick walk-through of the work before starting. No surprises, no upsells.",
    icon: "lucide:clock",
  },
  {
    number: "03",
    title: "Work Done Right, Guaranteed",
    description:
      "We complete the job to a high standard and clean up after ourselves. If anything isn't right, we come back and fix it free of charge. That's our promise.",
    icon: "lucide:circle-check-big",
  },
];
---

<section class="py-20 lg:py-28 bg-neutral-50">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20">
      <div class="lg:sticky lg:top-28 self-start" data-aos="fade-up">
        <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-primary-900 leading-[1.05]">
          Three steps from quote to done
        </h2>
        <p class="text-neutral-600 text-lg mt-4 leading-relaxed max-w-md">
          No runaround. You know what happens next at every step.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold px-7 h-14 rounded-xl transition-colors shadow-sm"
        >
          Start with a free quote
          <Icon name="lucide:arrow-right" class="w-5 h-5" />
        </a>
      </div>

      <ol class="relative">
        <div class="absolute left-[1.65rem] top-6 bottom-6 w-px bg-neutral-300" aria-hidden="true"></div>
        {steps.map((step, i) => (
          <li class="relative flex gap-6 pb-10 last:pb-0" data-aos="fade-up" data-aos-delay={(i + 1) * 80}>
            <div class="relative z-10 grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-primary-900 text-white font-heading text-xl font-bold">{step.number}</div>
            <div class="rounded-2xl bg-white p-6 ring-1 ring-neutral-200 flex-1">
              <div class="flex items-center gap-2.5">
                <Icon name={step.icon} class="w-5 h-5 text-accent-700" />
                <h3 class="font-heading font-bold text-xl text-primary-900">{step.title}</h3>
              </div>
              <p class="text-neutral-600 leading-relaxed mt-2">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
