---
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";
---

<section class="bg-white py-16 lg:py-24">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="relative isolate overflow-hidden rounded-3xl bg-primary-900 px-6 py-16 text-center sm:px-12 lg:py-20">
      <div class="hero-glow absolute inset-0 -z-10"></div>
      <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-white leading-[1.05] max-w-2xl mx-auto" data-aos="fade-up">
        Get your free quote today
      </h2>
      <p class="text-white/75 text-lg mt-5 leading-relaxed max-w-xl mx-auto" data-aos="fade-up" data-aos-delay="100">
        No obligation and no pressure. We usually reply the same business day.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-9" data-aos="fade-up" data-aos-delay="200">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-bold text-lg px-8 h-14 rounded-xl transition-all duration-200 shadow-lg shadow-black/20 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
        >
          Get a free quote
        </a>
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 border border-white/30 hover:bg-white/10 text-white font-semibold text-lg px-8 h-14 rounded-xl transition-colors"
        >
          <Icon name="lucide:phone" class="w-5 h-5 shrink-0" />
          Call {business.phone}
        </a>
      </div>

      <p class="text-white/65 text-sm mt-7" data-aos="fade-up" data-aos-delay="300">
        {[business.guaranteeText, ...business.ctaProof].join(", ")}. Serving {business.city} and a {business.serviceRadius}.
      </p>
    </div>
  </div>
</section>
