---
import { Icon } from "astro-icon/components";
import { business } from "@/config/business";

const items = [
  {
    icon: "lucide:star",
    label: `Rated ${business.rating}/5`,
    sub: `${business.reviewCount}+ verified reviews`,
  },
  {
    icon: "lucide:shield-check",
    label: "Licensed & Insured",
    sub: "Fully bonded & certified",
  },
  {
    icon: "lucide:badge-check",
    label: business.guaranteeText,
    sub: "Or we make it right, free",
  },
  {
    icon: "lucide:clock",
    label: "Fast Response",
    sub: "Same & next-day availability",
  },
];
---

<section class="relative z-10 -mt-16 lg:-mt-20 pb-4">
  <div class="max-w-(--breakpoint-xl) mx-auto px-5">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6 rounded-2xl bg-white p-6 lg:p-8 shadow-xl shadow-primary-900/10 ring-1 ring-neutral-200">
      {items.map((item, i) => (
        <div class="group flex items-center gap-3.5" data-aos="fade-up" data-aos-delay={(i + 1) * 80}>
          <div class="shrink-0 grid h-11 w-11 place-items-center rounded-xl bg-primary-50 text-primary-700"><Icon name={item.icon} class="w-5 h-5" /></div>
          <div>
            <div class="font-semibold text-primary-900 text-sm leading-tight">{item.label}</div>
            <div class="text-neutral-600 text-xs mt-1">{item.sub}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
